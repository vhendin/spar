# Copy to .env (which is not committed) and fill in to let the importer download
# Lantmäteriet's 1 m elevation model. The login is a Geotorget account that has ordered
# the free product "Markhöjdmodell Nedladdning".
LANTMATERIET_USER=
LANTMATERIET_PASSWORD=

# Token of the Cloudflare Tunnel that lets friends outside the home network join
# (docker compose --profile tunnel up -d); see compose.yaml.
TUNNEL_TOKEN=

# Logins through Cloudflare Access, so each friend's name, logbook and settings are kept on
# the server. Both from the Zero Trust dashboard: the team domain (Settings → Team name and
# domain, as "example.cloudflareaccess.com", or just "example"), and the Application Audience
# (AUD) tag on the Spår application's Basic information. Leave empty for no logins.
ACCESS_TEAM=
ACCESS_AUD=
