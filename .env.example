# Copy to .env (which is not committed) and fill in to let the importer download
# Lantmäteriet's 1 m elevation model. The login is a Geotorget account that has ordered
# the free product "Markhöjdmodell Nedladdning".
LANTMATERIET_USER=
LANTMATERIET_PASSWORD=

# Token of the Cloudflare Tunnel that lets friends outside the home network join
# (docker compose --profile tunnel up -d); see compose.yaml.
TUNNEL_TOKEN=
