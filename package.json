{
  "name": "spar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @spar/server run start",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "gen": "pnpm --filter @spar/shared run gen"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
