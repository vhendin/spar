{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GroundClasses",
  "description": "The land cover (biome) classes and the surface classes of narrow features (roads, paths, streams) stored in region masks. Lives in defs/ground.json. Ids are what the mask files hold; never renumber, only append.",
  "type": "object",
  "additionalProperties": false,
  "required": ["biomes", "surfaces"],
  "properties": {
    "biomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/GroundClass" } },
    "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/GroundClass" } }
  },
  "definitions": {
    "GroundClass": {
      "title": "GroundClass",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 255 },
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" }
      }
    }
  }
}
