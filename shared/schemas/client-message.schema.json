{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientMessage",
  "description": "Every message a client may send to the server.",
  "oneOf": [
    {
      "$ref": "#/definitions/Hello"
    },
    {
      "$ref": "#/definitions/SetWorld"
    },
    {
      "$ref": "#/definitions/Profile"
    },
    {
      "$ref": "#/definitions/State"
    },
    {
      "$ref": "#/definitions/Away"
    },
    {
      "$ref": "#/definitions/Chat"
    },
    {
      "$ref": "#/definitions/Push"
    },
    {
      "$ref": "#/definitions/Room"
    },
    {
      "$ref": "#/definitions/Felled"
    },
    {
      "$ref": "#/definitions/BrokeIce"
    },
    {
      "$ref": "#/definitions/Cable"
    },
    {
      "$ref": "#/definitions/Free"
    },
    {
      "$ref": "#/definitions/Drive"
    },
    {
      "$ref": "#/definitions/Handover"
    }
  ],
  "definitions": {
    "Hello": {
      "title": "Hello",
      "description": "First message on a new connection, with the driver's name and colour.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "description": "The driver's name as others see it; empty lets the server name them.",
          "type": "string",
          "maxLength": 24
        },
        "color": {
          "description": "The vehicle's paint as #rrggbb; left out, the vehicle keeps its own colours.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "token": {
          "description": "Chosen by the browser tab and kept across reconnects: coming back with it within a minute keeps the same player.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        }
      }
    },
    "SetWorld": {
      "title": "SetWorld",
      "description": "Asks the server to change the clock or the weather for everyone. Any field left out stays as it is.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "set_world"
        },
        "hour": {
          "description": "Local time of day to jump to, in hours (0 midnight, 13.5 half past one). The date stays.",
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "day": {
          "description": "Day of the year to jump to (1 is 1 January), in the same year and at the same time of day.",
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "dayMinutes": {
          "description": "Real minutes one in-game day takes from now on; 0 stops the clock, 1440 is real time.",
          "type": "number",
          "minimum": 0,
          "maximum": 1440
        },
        "weather": {
          "description": "A state to hold the weather in, or auto to let it change by itself.",
          "type": "string",
          "enum": [
            "auto",
            "clear",
            "overcast",
            "rain"
          ]
        }
      }
    },
    "Profile": {
      "title": "Profile",
      "description": "A new name or colour for this driver.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "profile"
        },
        "name": {
          "description": "The driver's name as others see it; empty lets the server name them.",
          "type": "string",
          "maxLength": 24
        },
        "color": {
          "description": "The vehicle's paint as #rrggbb; left out, the vehicle keeps its own colours.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "VehicleSnapshot": {
      "title": "VehicleSnapshot",
      "description": "How a driver's vehicle stands at one moment, sent about 20 times a second so others can draw it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "vehicle",
        "jump",
        "t",
        "paused",
        "p",
        "q",
        "v",
        "wheels",
        "lights",
        "braking",
        "ground",
        "engine",
        "wading"
      ],
      "properties": {
        "region": {
          "description": "The region being driven; others draw the vehicle only in the same one.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "vehicle": {
          "description": "Name of the vehicle definition.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "jump": {
          "description": "Goes up whenever the vehicle is put somewhere new, so others jump it there instead of sliding it.",
          "type": "integer",
          "minimum": 0
        },
        "t": {
          "description": "The sender's clock, milliseconds; only differences between its own snapshots matter.",
          "type": "number"
        },
        "paused": {
          "description": "The driver has paused: the vehicle stands still.",
          "type": "boolean"
        },
        "p": {
          "description": "Position of the body, metres.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "q": {
          "description": "Rotation of the body, quaternion x, y, z, w.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "v": {
          "description": "Velocity of the body, metres a second.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "wheels": {
          "description": "Per wheel, in the definition's order: steering angle (radians), suspension length (metres), sink into soft ground (metres), drive spin (0..1), brake skid (0..1), sideways slide (m/s) and water over the ground under it (metres).",
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 7,
            "maxItems": 7
          }
        },
        "lights": {
          "description": "Headlights on.",
          "type": "boolean"
        },
        "braking": {
          "description": "Brake lights on.",
          "type": "boolean"
        },
        "ground": {
          "description": "Per wheel, the kind of ground under the tyre, empty while it is off the ground.",
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^[a-z]*$",
            "maxLength": 16
          }
        },
        "engine": {
          "description": "What the engine is doing, for its sound and exhaust.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rpm",
            "gear",
            "low",
            "shifting",
            "pedal",
            "drowned"
          ],
          "properties": {
            "rpm": {
              "type": "number",
              "minimum": 0
            },
            "gear": {
              "description": "-1 reverse, 1.. forward gears.",
              "type": "integer"
            },
            "low": {
              "description": "Low range engaged.",
              "type": "boolean"
            },
            "shifting": {
              "description": "A gear change in progress: no drive.",
              "type": "boolean"
            },
            "pedal": {
              "description": "The pedal driving the engine, 0..1.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "drowned": {
              "description": "Water has got into the engine and stopped it.",
              "type": "boolean"
            }
          }
        },
        "wading": {
          "description": "Deepest water around the vehicle, metres above the bottom of its tyres.",
          "type": "number",
          "minimum": 0
        },
        "winch": {
          "$ref": "#/definitions/SnapshotWinch"
        }
      }
    },
    "SnapshotWinch": {
      "title": "SnapshotWinch",
      "description": "The winch's cable while it is out, so others can draw it. Left out while it is on the drum.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "end",
        "length",
        "tension",
        "drum"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "carrying",
            "hooked",
            "reeling"
          ]
        },
        "end": {
          "description": "The cable's far end, world position, metres.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "length": {
          "description": "Cable out, metres.",
          "type": "number",
          "minimum": 0
        },
        "tension": {
          "description": "Newtons the cable pulls with.",
          "type": "number",
          "minimum": 0
        },
        "drum": {
          "description": "Metres a second of cable, positive winding in.",
          "type": "number"
        },
        "strap": {
          "description": "Round a trunk or rock: its middle and the strap's radius.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "State": {
      "title": "State",
      "description": "A vehicle now: this driver's own, or with `of` one this browser runs for another driver while they are joined by a cable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "vehicle"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "state"
        },
        "of": {
          "description": "The player whose vehicle this is, when it is not the sender's own.",
          "type": "string",
          "maxLength": 64
        },
        "vehicle": {
          "$ref": "#/definitions/VehicleSnapshot"
        }
      }
    },
    "Away": {
      "title": "Away",
      "description": "This driver's vehicle has left the road (back at the start screen): others stop drawing it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "away"
        }
      }
    },
    "Chat": {
      "title": "Chat",
      "description": "A line of chat to everyone.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "Push": {
      "title": "Push",
      "description": "Our vehicle pushed against another driver's vehicle: the push for their browser to apply, since only it moves that vehicle.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "to",
        "impulse",
        "at"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "push"
        },
        "to": {
          "description": "The player whose vehicle was pushed.",
          "type": "string",
          "maxLength": 64
        },
        "impulse": {
          "description": "Impulse on their vehicle, newton-seconds, world frame.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "at": {
          "description": "Where it pushed, world position, metres.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "Room": {
      "title": "Room",
      "description": "This driver is now in this region: the server sends back what has changed in it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "region"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "room"
        },
        "region": {
          "description": "The region it happened in.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        }
      }
    },
    "FelledTree": {
      "title": "FelledTree",
      "description": "A tree knocked down: kept by the server for the session and passed on to everyone in the region.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "x",
        "z",
        "dx",
        "dz",
        "diameter"
      ],
      "properties": {
        "key": {
          "description": "The tree's permanent key: layer, cell x, cell z.",
          "type": "string",
          "pattern": "^[0-9a-z_-]+:-?[0-9]+:-?[0-9]+$",
          "maxLength": 48
        },
        "x": {
          "description": "Where it stood, metres east.",
          "type": "number"
        },
        "z": {
          "description": "Where it stood, metres south.",
          "type": "number"
        },
        "dx": {
          "description": "The way it fell: a unit vector on the ground, east part.",
          "type": "number"
        },
        "dz": {
          "description": "The way it fell, south part.",
          "type": "number"
        },
        "diameter": {
          "description": "Trunk diameter, metres, for the sound of it.",
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "Felled": {
      "title": "Felled",
      "description": "Our vehicle or winch knocked a tree down.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "region",
        "tree"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "felled"
        },
        "region": {
          "description": "The region it happened in.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "tree": {
          "$ref": "#/definitions/FelledTree"
        }
      }
    },
    "IceHole": {
      "title": "IceHole",
      "description": "Where a vehicle broke through the ice.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "z"
      ],
      "properties": {
        "x": {
          "description": "Metres east.",
          "type": "number"
        },
        "z": {
          "description": "Metres south.",
          "type": "number"
        }
      }
    },
    "BrokeIce": {
      "title": "BrokeIce",
      "description": "Our vehicle broke through the ice.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "region",
        "hole"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "ice_hole"
        },
        "region": {
          "description": "The region it happened in.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "hole": {
          "$ref": "#/definitions/IceHole"
        }
      }
    },
    "Cable": {
      "title": "Cable",
      "description": "A winch this browser runs has hooked on to another driver's vehicle (`to`), or let go of it (no `to`). The server answers with `towing`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "from",
        "seq"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "cable"
        },
        "from": {
          "description": "The player whose vehicle's winch it is.",
          "type": "string",
          "maxLength": 64
        },
        "to": {
          "description": "The player whose vehicle it is hooked to.",
          "type": "string",
          "maxLength": 64
        },
        "seq": {
          "description": "Counts this browser's cable messages; `towing` says which it has seen.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Free": {
      "title": "Free",
      "description": "Our vehicle is being moved somewhere new: every cable on it, or from it, comes off.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "seq"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "free"
        },
        "seq": {
          "description": "Counts with `cable`: `towing` says when it has been seen.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Anchor": {
      "title": "Anchor",
      "description": "Something a winch is hooked to: a tree, rock or building by its permanent key, or another driver's vehicle.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "x",
        "y",
        "z",
        "radius",
        "diameter"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": [
            "tree",
            "rock",
            "object",
            "vehicle"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "diameter": {
          "type": "number",
          "minimum": 0
        },
        "box": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hx",
            "hz",
            "yaw"
          ],
          "properties": {
            "hx": {
              "type": "number"
            },
            "hz": {
              "type": "number"
            },
            "yaw": {
              "type": "number"
            }
          }
        },
        "vehicle": {
          "description": "The player whose vehicle it is.",
          "type": "string",
          "maxLength": 64
        },
        "local": {
          "description": "Where on that vehicle, in its own frame, metres.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "DriveControls": {
      "title": "DriveControls",
      "description": "A driver's controls, for the browser that runs their vehicle while it is joined to another by a cable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "throttle",
        "brake",
        "steer",
        "handbrake",
        "digital",
        "pull",
        "slack",
        "lights"
      ],
      "properties": {
        "throttle": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "brake": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "steer": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "handbrake": {
          "type": "boolean"
        },
        "digital": {
          "description": "The pedals are keys, only on or off.",
          "type": "boolean"
        },
        "pull": {
          "description": "Winching in.",
          "type": "boolean"
        },
        "slack": {
          "description": "Paying cable out.",
          "type": "boolean"
        },
        "lights": {
          "type": "boolean"
        },
        "range": {
          "description": "Change between high and low range, once.",
          "type": "boolean"
        },
        "lock": {
          "description": "Lock or free this axle's differential, once.",
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "right": {
          "description": "Put the vehicle back on its wheels.",
          "type": "boolean"
        },
        "hook": {
          "$ref": "#/definitions/Anchor"
        },
        "release": {
          "description": "Unhook the winch.",
          "type": "boolean"
        }
      }
    },
    "Drive": {
      "title": "Drive",
      "description": "Our controls, while another browser runs our vehicle; sent about 20 times a second and at once on a key press.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "controls"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "drive"
        },
        "controls": {
          "$ref": "#/definitions/DriveControls"
        }
      }
    },
    "WinchHandover": {
      "title": "WinchHandover",
      "description": "Everything about a winch needed to carry on running it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "point",
        "end",
        "length",
        "carried",
        "reelFrom",
        "reelStart"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "stowed",
            "carrying",
            "hooked",
            "reeling"
          ]
        },
        "anchor": {
          "$ref": "#/definitions/Anchor"
        },
        "point": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "end": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "length": {
          "type": "number"
        },
        "carried": {
          "type": "number"
        },
        "reelFrom": {
          "type": "number"
        },
        "reelStart": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "VehicleHandover": {
      "title": "VehicleHandover",
      "description": "Everything about a vehicle needed to carry on simulating it in another browser.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle",
        "jump",
        "p",
        "q",
        "v",
        "w",
        "wheels",
        "gear",
        "low",
        "rpm",
        "locks",
        "holding",
        "drowned",
        "steer"
      ],
      "properties": {
        "vehicle": {
          "description": "Name of the vehicle definition.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "jump": {
          "type": "integer",
          "minimum": 0
        },
        "p": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "q": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "v": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "w": {
          "description": "Spin, radians a second.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "wheels": {
          "description": "Per wheel: sink, water, suspension length, roll (radians).",
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "gear": {
          "type": "integer"
        },
        "low": {
          "type": "boolean"
        },
        "rpm": {
          "type": "number"
        },
        "locks": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "boolean"
          }
        },
        "holding": {
          "type": "boolean"
        },
