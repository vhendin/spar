{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegionVectors",
  "description": "Line and outline data of a region, written by the importer to vectors.json. All coordinates are [x, z] in metres from the north-west corner: x east, z south.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roads",
    "waterways",
    "lakes",
    "places",
    "spawns",
    "buildings",
    "powerLines",
    "fences",
    "objects"
  ],
  "properties": {
    "roads": {
      "type": "array",
      "items": {
        "title": "RoadLine",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "surface",
          "width",
          "drivable",
          "points"
        ],
        "properties": {
          "id": {
            "description": "Stable id: OpenStreetMap way id, plus a part number when the way was cut at the area edge.",
            "type": "string"
          },
          "kind": {
            "description": "OpenStreetMap highway value.",
            "type": "string"
          },
          "surface": {
            "description": "Name of a surface class.",
            "type": "string"
          },
          "width": {
            "description": "Metres.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "drivable": {
            "description": "True for ways meant for motor vehicles.",
            "type": "boolean"
          },
          "bridge": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "points": {
            "$ref": "#/definitions/Line"
          }
        }
      }
    },
    "waterways": {
      "type": "array",
      "items": {
        "title": "Waterway",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "description": "OpenStreetMap waterway value, such as stream or river.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "points": {
            "$ref": "#/definitions/Line"
          }
        }
      }
    },
    "lakes": {
      "type": "array",
      "items": {
        "title": "Lake",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "outline"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "description": "Water surface elevation in metres.",
            "type": "number"
          },
          "outline": {
            "description": "Outer shoreline, cut at the area edge.",
            "$ref": "#/definitions/Line"
          }
        }
      }
    },
    "places": {
      "type": "array",
      "items": {
        "title": "Place",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "x",
          "z"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        }
      }
    },
    "destinations": {
      "description": "Places worth driving to: summits, huts, shelters, viewpoints, lodges, camp sites and sights from OpenStreetMap, and the top station of every lift. Unnamed ones are named by kind and position. Optional: older regions have none.",
      "type": "array",
      "items": {
        "title": "DestinationPoint",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "x",
          "z"
        ],
        "properties": {
          "id": {
            "description": "OpenStreetMap id, such as n123 or w456; for a lift top, the lift's.",
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "peak",
              "hut",
              "shelter",
              "viewpoint",
              "lodge",
              "camp",
              "sight",
              "lift"
            ]
          },
          "name": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "ele": {
            "description": "Height above sea level from the map (for a lift top, from the ground), metres.",
            "type": "number"
          }
        }
      }
    },
    "finds": {
      "description": "Small things to find, quieter than destinations: summer farms, waterfalls, rapids, springs, historic places, fords and passes from OpenStreetMap. Logged once reached; no trips to them. Fords are thinned to one every few hundred metres. Unnamed ones are named by kind and position. Optional: older regions have none.",
      "type": "array",
      "items": {
        "title": "FindPoint",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "x",
          "z"
        ],
        "properties": {
          "id": {
            "description": "OpenStreetMap id, such as n123 or w456.",
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "farm",
              "waterfall",
              "rapids",
              "spring",
              "historic",
              "ford",
              "pass"
            ]
          },
          "what": {
            "description": "For a historic place, what it is: the historic tag's value (boundary_stone, memorial, monument, aircraft_wreck, mine, ruins, tomb, wayside_cross), or cairn.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "ele": {
            "description": "Height above sea level from the map, metres.",
            "type": "number"
          }
        }
      }
    },
    "trails": {
      "description": "Trails to drive, made from the map: stretches of 2–8 km of the named hiking routes and the snowmobile trails, power-line corridors, and ascents (the shortest line a vehicle can climb from a road to a named summit). Driven from either end. Optional: older regions have none.",
      "type": "array",
      "items": {
        "title": "TrailLine",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "points",
          "length"
        ],
        "properties": {
          "id": {
            "description": "Stable from the map data: the kind, the first OpenStreetMap id and the stretch's number.",
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "hiking",
              "snowmobile",
              "power",
              "ascent"
            ]
          },
          "name": {
            "description": "Such as \"Kungsleden: Sälka – Tjäktja\" or \"Ascent of Ottfjället\".",
            "type": "string"
          },
          "points": {
            "$ref": "#/definitions/Line"
          },
          "length": {
            "description": "Along the line, metres.",
            "type": "number"
          },
          "climb": {
            "description": "Height gained from the first point to the last, metres (for an ascent).",
            "type": "number"
          }
        }
      }
    },
    "spawns": {
      "description": "Points on drivable roads where a vehicle can start; the first is the default.",
      "type": "array",
      "items": {
        "title": "SpawnPoint",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "x",
          "z",
          "heading",
          "road"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "heading": {
            "description": "Direction along the road in degrees: 0 north, 90 east.",
            "type": "number"
          },
          "road": {
            "description": "Id of the road the point lies on.",
            "type": "string"
          }
        }
      }
    },
    "buildings": {
      "description": "Building footprints from OpenStreetMap.",
      "type": "array",
      "items": {
        "title": "Building",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "outline"
        ],
        "properties": {
          "id": {
            "description": "Stable id: OpenStreetMap id, plus a part number for multipolygons.",
            "type": "string"
          },
          "kind": {
            "description": "OpenStreetMap building value, such as house, cabin, barn or yes.",
            "type": "string"
          },
          "levels": {
            "description": "Storeys above ground, when mapped.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "description": "Height in metres, when mapped.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "roof": {
            "description": "OpenStreetMap roof:shape, when mapped.",
            "type": "string"
          },
          "outline": {
            "description": "Footprint corners, not repeating the first.",
            "$ref": "#/definitions/Line"
          }
        }
      }
    },
    "powerLines": {
      "description": "Overhead power lines. Every point is a tower or pole; points outside the area only carry the wires.",
      "type": "array",
      "items": {
        "title": "PowerLine",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "description": "OpenStreetMap power value: line or minor_line.",
            "type": "string"
          },
          "voltage": {
            "description": "Highest voltage in kV, when mapped.",
            "type": "number"
          },
          "points": {
            "$ref": "#/definitions/Line"
          }
        }
      }
    },
    "lifts": {
      "description": "Ski lifts and gondolas, from end station to end station. Points between the ends are towers where mapped; the game adds towers where the ground needs them. Points outside the area only carry the cable. Missing in regions built before lifts were imported.",
      "type": "array",
      "items": {
        "title": "Lift",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "description": "OpenStreetMap aerialway value: chair_lift, gondola, cable_car, mixed_lift, drag_lift, t-bar, j-bar, platter, rope_tow or magic_carpet.",
            "type": "string"
          },
          "name": {
            "description": "Name, or the lift's number when it has no name.",
            "type": "string"
          },
          "occupancy": {
            "description": "People per chair or cabin, when mapped.",
            "type": "integer",
            "minimum": 1
          },
          "points": {
            "$ref": "#/definitions/Line"
          }
        }
      }
    },
    "fences": {
      "description": "Fences and walls: mapped ones, and fences along field edges.",
      "type": "array",
      "items": {
        "title": "FenceLine",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "description": "Name of an object definition: roundpole, wire or stone_wall.",
            "type": "string"
          },
          "points": {
            "$ref": "#/definitions/Line"
          }
        }
      }
    },
    "objects": {
      "description": "Single man-made objects placed by the importer, such as log piles beside fresh clear-cuts.",
      "type": "array",
      "items": {
        "title": "PlacedObject",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "x",
          "z",
          "heading"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "description": "Name of an object definition.",
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "heading": {
            "description": "Degrees: 0 north, 90 east.",
            "type": "number"
          },
          "road": {
            "description": "Id of the road it stands beside.",
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "Line": {
      "title": "Line",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    }
  }
}
