{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerMessage",
  "description": "Every message the server may send to a client.",
  "oneOf": [
    {
      "$ref": "#/definitions/Welcome"
    },
    {
      "$ref": "#/definitions/WorldUpdate"
    },
    {
      "$ref": "#/definitions/ServerError"
    },
    {
      "$ref": "#/definitions/Players"
    },
    {
      "$ref": "#/definitions/PlayerState"
    },
    {
      "$ref": "#/definitions/PlayerAway"
    },
    {
      "$ref": "#/definitions/ChatLine"
    },
    {
      "$ref": "#/definitions/PlayerPush"
    },
    {
      "$ref": "#/definitions/RoomState"
    },
    {
      "$ref": "#/definitions/TreeFelled"
    },
    {
      "$ref": "#/definitions/IceBroken"
    }
  ],
  "definitions": {
    "Welcome": {
      "title": "Welcome",
      "description": "Reply to hello: who you are and which world to load.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "playerId",
        "region",
        "seed"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "ServerError": {
      "title": "ServerError",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "bad_message",
            "protocol_mismatch"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "WorldUpdate": {
      "title": "WorldUpdate",
      "description": "The game clock and the weather, which the server owns. Sent after welcome and every few seconds; clients run the clock on by themselves in between and ease towards new weather.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "time",
        "weather"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "world"
        },
        "time": {
          "title": "WorldTime",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "utc",
            "rate",
            "utcOffset"
          ],
          "properties": {
            "utc": {
              "description": "The in-game instant now, as UTC milliseconds.",
              "type": "number"
            },
            "rate": {
              "description": "In-game seconds per real second.",
              "type": "number",
              "minimum": 0
            },
            "utcOffset": {
              "description": "Hours the region's clocks are ahead of UTC.",
              "type": "number"
            }
          }
        },
        "weather": {
          "title": "WorldWeather",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "cloud",
            "rain",
            "wind",
            "windDirection",
            "wetness"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "clear",
                "overcast",
                "rain"
              ]
            },
            "cloud": {
              "description": "Share of the sky covered by cloud.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rain": {
              "description": "Rainfall, 0 none to 1 downpour.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wind": {
              "description": "Wind strength, 0 calm to 1 gale.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "windDirection": {
              "description": "Compass bearing the wind blows towards, degrees.",
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "wetness": {
              "description": "How wet the ground is, 0 dry to 1 soaked.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "Players": {
      "title": "Players",
      "description": "Everyone connected, sent whenever someone joins, leaves or changes name or colour.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "players"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "players"
        },
        "players": {
          "type": "array",
          "items": {
            "title": "Player",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "region": {
                "description": "The region they are in, once they have entered one.",
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              }
            }
          }
        }
      }
    },
    "PlayerState": {
      "title": "PlayerState",
      "description": "Another driver's vehicle now, passed on as they sent it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "vehicle"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "state"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vehicle": {
          "$ref": "client-message.schema.json#/definitions/VehicleSnapshot"
        }
      }
    },
    "PlayerAway": {
      "title": "PlayerAway",
      "description": "Another driver's vehicle has left the road.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "away"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ChatLine": {
      "title": "ChatLine",
      "description": "A line of chat; without `from` it is the server telling everyone something (a player joined, the weather was changed).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        },
        "from": {
          "description": "Player id of the sender.",
          "type": "string"
        },
        "name": {
          "description": "The sender's name when it was said.",
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "PlayerPush": {
      "title": "PlayerPush",
      "description": "Another driver's vehicle pushed against ours; apply it to our body.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "from",
        "impulse",
        "at"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "push"
        },
        "from": {
          "type": "string"
        },
        "impulse": {
          "description": "Impulse on our vehicle, newton-seconds, world frame.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "at": {
          "description": "Where it pushed, world position, metres.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "RoomState": {
      "title": "RoomState",
      "description": "What has changed in a region this session: sent to a driver entering it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "region",
        "felled",
        "holes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "room"
        },
        "region": {
          "description": "The region it happened in.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "felled": {
          "type": "array",
          "items": {
            "$ref": "client-message.schema.json#/definitions/FelledTree"
          }
        },
        "holes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "client-message.schema.json#/definitions/IceHole"
          }
        }
      }
    },
    "TreeFelled": {
      "title": "TreeFelled",
      "description": "Another driver knocked a tree down.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "region",
        "tree"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "felled"
        },
        "region": {
          "description": "The region it happened in.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "tree": {
          "$ref": "client-message.schema.json#/definitions/FelledTree"
        }
      }
    },
    "IceBroken": {
      "title": "IceBroken",
      "description": "Another driver broke through the ice.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "region",
        "hole"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "ice_hole"
        },
        "region": {
          "description": "The region it happened in.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "hole": {
          "$ref": "client-message.schema.json#/definitions/IceHole"
        }
      }
    }
  }
}
