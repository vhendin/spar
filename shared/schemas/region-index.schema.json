{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegionIndex",
  "description": "Written by the importer to data/regions/<name>/index.json; everything the game needs to load a region. Local coordinates: x runs east and z runs south from the north-west corner, in metres. Rasters are stored north row first.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "name",
    "title",
    "crs",
    "origin",
    "size",
    "tileSize",
    "center",
    "heights",
    "masks",
    "horizon",
    "vectors",
    "attribution"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 3
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "crs": {
      "type": "string"
    },
    "origin": {
      "title": "RegionIndexOrigin",
      "description": "North-west corner in the projected coordinate system.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "easting",
        "northing"
      ],
      "properties": {
        "easting": {
          "type": "number"
        },
        "northing": {
          "type": "number"
        }
      }
    },
    "size": {
      "description": "Side of the square area in metres.",
      "type": "integer",
      "minimum": 1
    },
    "tileSize": {
      "description": "Side of one world tile in metres; object placement works per world tile.",
      "type": "integer",
      "const": 256
    },
    "center": {
      "title": "RegionCenter",
      "description": "Geographic position of the middle of the area, for sun and moon.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "heights": {
      "title": "HeightPyramid",
      "description": "Ground elevation as a pyramid of square files. A file at level L holds `samples` x `samples` heights spaced 2^L metres, so it spans (samples - 1) * 2^L metres, plus `apron` extra samples on every side for slope calculations. Neighbouring files share their edge samples, and every level is a subsample of the finest one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "samples",
        "apron",
        "levels",
        "encoding",
        "min",
        "max",
        "source"
      ],
      "properties": {
        "path": {
          "description": "File path template below the region folder, with {level}, {x} and {y}; x counts east and y counts south.",
          "type": "string"
        },
        "samples": {
          "type": "integer",
          "const": 257
        },
        "apron": {
          "type": "integer",
          "minimum": 0
        },
        "levels": {
          "description": "Levels present, finest first.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/PyramidLevel"
          }
        },
        "encoding": {
          "$ref": "#/definitions/HeightEncoding"
        },
        "min": {
          "description": "Lowest elevation in the area, metres.",
          "type": "number"
        },
        "max": {
          "description": "Highest elevation in the area, metres.",
          "type": "number"
        },
        "source": {
          "title": "ElevationSourceInfo",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "resolution",
            "kind"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "resolution": {
              "description": "True ground resolution of the source in metres.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "kind": {
              "description": "terrain = bare ground; surface = includes tree tops and roofs.",
              "type": "string",
              "enum": [
                "terrain",
                "surface"
              ]
            }
          }
        }
      }
    },
    "horizon": {
      "title": "Horizon",
      "description": "One coarse height grid reaching beyond the area, for distant terrain.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "samples",
        "spacing",
        "margin",
        "encoding",
        "biome"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "samples": {
          "description": "Samples per side.",
          "type": "integer",
          "minimum": 2
        },
        "spacing": {
          "description": "Metres between samples.",
          "type": "integer",
          "minimum": 1
        },
        "margin": {
          "description": "Metres the grid reaches beyond the area on every side.",
          "type": "integer",
          "minimum": 0
        },
        "encoding": {
          "$ref": "#/definitions/HeightEncoding"
        },
        "biome": {
          "title": "HorizonBiome",
          "description": "Land cover for the horizon: one byte per sample, covering the same square as the horizon heights.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "samples",
            "spacing"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "samples": {
              "type": "integer",
              "minimum": 2
            },
            "spacing": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "attribution": {
      "description": "Credit lines for the data used.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "masks": {
      "title": "MaskPyramid",
      "description": "Ground properties as a pyramid of files laid out like the height pyramid, without an apron. A file holds one plane of `samples` x `samples` bytes per channel, in the order of `channels`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "samples",
        "levels",
        "channels",
        "biomes",
        "surfaces",
        "treeline"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "samples": {
          "type": "integer",
          "const": 257
        },
        "levels": {
          "description": "Levels present, finest first.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/PyramidLevel"
          }
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "MaskChannel",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "biome",
                  "surface",
                  "road",
                  "wetness",
                  "canopy",
                  "slope"
                ]
              },
              "kind": {
                "description": "class = an id from biomes or surfaces; value = a quantity equal to byte * scale.",
                "type": "string",
                "enum": [
                  "class",
                  "value"
                ]
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "biomes": {
          "description": "Land cover classes by id.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/GroundClass"
          }
        },
        "surfaces": {
          "description": "Surface classes of roads, paths and streams by id; 0 means plain ground.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/GroundClass"
          }
        },
        "treeline": {
          "description": "Elevation in metres above which forest gives way to open fell.",
          "type": "number"
        }
      }
    },
    "vectors": {
      "title": "VectorsRef",
      "description": "Roads, waterways, lakes, places and spawn points; see the region-vectors schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "HeightEncoding": {
      "title": "HeightEncoding",
      "description": "Heights are unsigned 16-bit little-endian integers; metres = offset + value * scale.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "offset",
        "scale"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "uint16-le"
        },
        "offset": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "PyramidLevel": {
      "title": "PyramidLevel",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "spacing",
        "span",
        "count"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "spacing": {
          "description": "Metres between samples.",
          "type": "integer",
          "minimum": 1
        },
        "span": {
          "description": "Metres covered by one file.",
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "description": "Files per side of the area.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "GroundClass": {
      "title": "GroundClass",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
